            "cornerRadius": "md",
            "paddingAll": "xs",
            "justifyContent": "center",
            "alignItems": "center",
            "contents": [
              {
                "type": "text",
                "text": "timetag",
                "size": "xs",
                "color": "header_font_color",
                "weight": "bold"
              }
